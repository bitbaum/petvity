# Secrets and settings this app reads at runtime. Copy to .env and fill in.
# Values live on the Hetzner box (/home/g/dev/<app>/.env), never in git.
DATABASE_URL=
# Signs sessions (AccountKit). BETTER_AUTH_SECRET also works; 32+ characters.
AUTH_SECRET=
AUTH_URL=
# Sign in with OrangeCat: both, or the button stays hidden.
ORANGECAT_OAUTH_CLIENT_ID=
ORANGECAT_OAUTH_CLIENT_SECRET=
# The shared bitbaum sign-in (Morulia): all three, or the button stays hidden.
SIGNIN_ISSUER=
SIGNIN_CLIENT_ID=
SIGNIN_CLIENT_SECRET=
ADMIN_EMAILS=
CRON_SECRET=
# Account mail (reset and sign-in links, address confirmation) and Petvity's own.
RESEND_API_KEY=
RESEND_FROM=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
UPLOADS_DIR=
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_APP_CURRENCY=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
NEXT_PUBLIC_FC_WIDGET_TOKEN=
